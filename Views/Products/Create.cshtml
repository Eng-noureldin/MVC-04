@model Session04_MVC.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="card shadow-sm p-4 col-md-8 mx-auto">
    <h2>Create Product (Session 04)</h2>
    <hr />
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_CreateEditPartial" model="Model" />

        <button type="submit" class="btn btn-success mt-3">Save Product</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
