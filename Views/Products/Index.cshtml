@model Session04_MVC.Helpers.PaginatedList<Session04_MVC.DAL.Product>

@{
    ViewData["Title"] = "Products Catalog (Session 04)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Products Inventory</h2>
    <a asp-action="Create" class="btn btn-success">+ New Product</a>
</div>

<!-- Search & Filtering Form -->
<div class="card mb-4 shadow-sm bg-light">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-5">
                <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Search product name..." />
            </div>
            <div class="col-md-4">
                <select name="categoryId" asp-items="@ViewBag.Categories" class="form-select">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<table class="table table-bordered table-striped table-hover shadow-sm align-middle">
    <thead class="table-dark">
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th class="text-center" style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No matching products found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width: 80px;" class="text-center">
                        @if (!string.IsNullOrEmpty(item.ImageName))
                        {
                            <img src="~/files/images/@item.ImageName" alt="@item.Name" class="img-thumbnail" style="max-height: 50px;" />
                        }
                        else
                        {
                            <span class="text-muted small">No Image</span>
                        }
                    </td>
                    <td class="fw-bold">@item.Name</td>
                    <td><span class="badge bg-secondary">@item.Category.Name</span></td>
                    <td class="text-success fw-bold">$@item.Price.ToString("F2")</td>
                    <td>@item.StockQuantity</td>
                    <td class="text-center">
                        <partial name="_ActionButtonsPartial" model="@item.Id" />
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Pagination Controls -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-searchName="@ViewBag.SearchName" asp-route-categoryId="@ViewBag.SelectedCategory">Previous</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchName="@ViewBag.SearchName" asp-route-categoryId="@ViewBag.SelectedCategory">@p</a>
                </li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-searchName="@ViewBag.SearchName" asp-route-categoryId="@ViewBag.SelectedCategory">Next</a>
            </li>
        </ul>
    </nav>
}
